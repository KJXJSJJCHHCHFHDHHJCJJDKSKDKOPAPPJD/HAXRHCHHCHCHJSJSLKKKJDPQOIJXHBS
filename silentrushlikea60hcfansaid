entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")

	task.spawn(function()
		local pla = game:GetService("Players")
		local rs = game:GetService("ReplicatedStorage")
		local rooms = workspace:WaitForChild("CurrentRooms")
		local ev = require(rs.ModulesClient.Module_Events)
		local lpla = pla.LocalPlayer

		local model = entity.Model


		local part = model and model:FindFirstChildWhichIsA("BasePart")
		local char = lpla.Character or lpla.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart")

		if not part then return end

		local active = false

		while entity.Model and entity.Model.Parent do
			char = lpla.Character
			hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp and part.Parent then
				local dist = (part.Position - hrp.Position).Magnitude

				if dist < 110 then
					if not active then
						active = true

						task.spawn(function()
							while active and entity.Model and entity.Model.Parent do
								char = lpla.Character
								hrp = char and char:FindFirstChild("HumanoidRootPart")

								if not hrp or not part.Parent or (part.Position - hrp.Position).Magnitude > 130 then
									active = false
									break
								end

								local room = rooms:FindFirstChild(tostring(rs.GameData.LatestRoom.Value))

								if room and room:IsA("Model") then
									ev.flicker(room, 1)
								end

								task.wait(1)
							end
						end)
					end
				else
					active = false
				end
			end

			task.wait(0.1)
		end

		active = false
	end)
end)


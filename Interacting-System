local DoorData = {}
local ignoredDoors = {}
local SpeedAutoPrompt = false
getgenv().Laziness = 0
getgenv().Lazied = false

local function GetGitSound(GithubSnd, SoundName, parent)
local url = GithubSnd
if not isfile(SoundName .. ".mp3") then
writefile(SoundName .. ".mp3", game:HttpGet(url))
end
local sound = Instance.new("Sound")
sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
sound.Parent = parent
return sound
end

local RunService = game:GetService("RunService")

-- Services & Variables
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local currentRooms = workspace:WaitForChild("CurrentRooms")
local hasKeyHitbox = false
local singularMode = math.random() <= 0.3
local LatestRoom = game:GetService("ReplicatedStorage"):WaitForChild("GameData"):WaitForChild("LatestRoom")

local function SetupDoorNormal(obj)
	if obj:GetAttribute("DoorNormalScanned") then
		return
	end

	task.spawn(function()
		local door
		local knob

		repeat
			if not obj.Parent then
				return
			end

			door = obj:FindFirstChild("Door")
			knob = obj:FindFirstChild("Knob", true)

			if not door or not knob then
				task.wait()
			end
		until door and knob

		if not obj.Parent or not door:IsA("MeshPart") then
			return
		end

		obj:SetAttribute("DoorNormalScanned", true)

		for _, v in ipairs(obj:GetDescendants()) do
			if v:IsA("BasePart") and (v.Name == "Hidden" or v.Name == "Hinge") then
				v.CanCollide = false
				v.Transparency = 1
			end
		end

		local cloneModel = obj:Clone()
		cloneModel.Name = "DoorClone"
		cloneModel.Parent = obj.Parent

		local cloneDoor = cloneModel:FindFirstChild("Door")
		local cloneKnob = cloneModel:FindFirstChild("Knob", true)
		local hidden = cloneModel:FindFirstChild("Hidden", true)
		local hinge = cloneModel:FindFirstChild("Hinge", true)

		if not cloneDoor or not cloneKnob then
			cloneModel:Destroy()
			obj:SetAttribute("DoorNormalScanned", nil)
			return
		end

		local openSound = cloneDoor:FindFirstChild("Open")
		local hitSound = cloneDoor:FindFirstChild("Hit")

		for _, v in ipairs(cloneModel:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name == "Hidden" or v.Name == "Hinge" then
					v.CanCollide = false
					v.Transparency = 1
				else
					v.CanCollide = true
					v.Transparency = 0
				end
			end
		end

		local oldCF = cloneDoor.CFrame

		local function GetOpenCF()
			local openAngle = 90

			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp then
				local relative = cloneDoor.CFrame:PointToObjectSpace(hrp.Position)

				if relative.Z > 0 then
					openAngle = -90
				end
			end

			local cf

			if hinge and hinge:IsA("BasePart") then
				local offset = hinge.CFrame:ToObjectSpace(oldCF)

				cf =
					hinge.CFrame
					* CFrame.Angles(0, math.rad(openAngle), 0)
					* offset
			else
				cf = oldCF * CFrame.Angles(0, math.rad(openAngle), 0)
			end

			return cf, openAngle
		end

		local openPrompt = Instance.new("ProximityPrompt")
		openPrompt.Style = Enum.ProximityPromptStyle.Custom
		openPrompt.ActionText = "Open Door"
		openPrompt.ObjectText = "Door"
		openPrompt.MaxActivationDistance = 10
		openPrompt.RequiresLineOfSight = false
		openPrompt.Parent = cloneKnob

		local closePrompt = openPrompt:Clone()
		closePrompt.ActionText = "Close Door"
		closePrompt.Enabled = false
		closePrompt.Parent = cloneKnob

		local hasTriggeredOnce = false

		openPrompt.Triggered:Connect(function()
			local openCF, openAngle = GetOpenCF()

			if not hasTriggeredOnce then
				hasTriggeredOnce = true

				if openAngle == -90 and math.random() < 0.07 then
					obj:SetAttribute("Singular", true)

					task.spawn(function()
						loadstring(game:HttpGet(
							"https://raw.githubusercontent.com/cakmay227-svg/REBLAHARDCOREDI/refs/heads/main/Singularity-3"
						))()
					end)
				end
			end

			openPrompt.Enabled = false
			closePrompt.Enabled = true

			if openSound and openSound:IsA("Sound") and not SpeedAutoPrompt then
				openSound:Play()
			end

			if hidden then
				hidden.Parent = cloneModel
			end

			TweenService:Create(
				cloneDoor,
				TweenInfo.new(
					1,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = openCF}
			):Play()
		end)

		closePrompt.Triggered:Connect(function()
			closePrompt.Enabled = false

			if hitSound and hitSound:IsA("Sound") then
				hitSound:Play()
			end

			local tween = TweenService:Create(
				cloneDoor,
				TweenInfo.new(
					1,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = oldCF}
			)

			tween:Play()
			tween.Completed:Wait()

			if hidden then
				hidden.Parent = nil
			end

			openPrompt.Enabled = true
		end)

		local busy = false

		openPrompt.PromptShown:Connect(function()
			if not SpeedAutoPrompt or busy or not openPrompt.Enabled then
				return
			end

			busy = true

			fireproximityprompt(openPrompt)

			if getgenv().Lazyness == true then
				if getgenv().SetStamina then
					getgenv().SetStamina(28)
				else
					print("bla")
				end
			end

			getgenv().LazyCount = getgenv().LazyCount or 0

			if not isfile("Lazied") then
				if getgenv().LazyCount < 20 then
					getgenv().LazyCount += 1
				end

				if getgenv().LazyCount >= 20 then
					writefile("Lazied", "")

					task.spawn(function()
						if isfile("LazyGot") then
							return
						end

						writefile("LazyGot", "")

						local CharmsNotify =
							loadstring(game:HttpGet(
								"https://raw.githubusercontent.com/PAKKALCKKWKKJXIODKRBFHHAUJCJJJSNDJ/HAXRHCHHCHCHJSJSLKKKJDPQOIJXHBS/refs/heads/main/CharmUnlock"
							))()

						CharmsNotify({
							Style = "UNLOCKED ACHIEVEMENT",
							Title = "Who Needs Keys?",
							Description = "The shoulder is a skeleton key, if you think hard enough.",
							Reason = "Slam open 20 side room doors in a single run by sprinting into them.",
							Image = "rbxassetid://74337438409089",
							Time = 5
						})
					end)
				end
			end

			if openSound then
				local slam = openSound:Clone()
				slam.SoundId = "rbxassetid://9114149321"
				slam.Volume = 1
				slam.Parent = cloneDoor

				slam.Ended:Once(function()
					slam:Destroy()
				end)

				slam:Play()
			end

			task.delay(0.15, function()
				busy = false
			end)
		end)

		door:Destroy()
	end)
end

local function SetupLockedDoor(door)
	if door:GetAttribute("LockedDoorScanned") then
		return
	end

	task.spawn(function()
		local realPrompt

		repeat
			if not door.Parent then
				return
			end

			realPrompt = nil

			for _, v in ipairs(door:GetDescendants()) do
				if v:IsA("ProximityPrompt") and v.Name == "UnlockPrompt" then
					realPrompt = v
					break
				end
			end

			if not realPrompt then
				task.wait()
			end
		until realPrompt

		if not door.Parent then
			return
		end

		if isfile("LazyGot") and getgenv().Lazyness == true then
			for _, v in ipairs(door:GetDescendants()) do
				if v:IsA("ProximityPrompt") then
					v.HoldDuration = v.HoldDuration * 2
				end
			end

			door.DescendantAdded:Connect(function(child)
				if child:IsA("ProximityPrompt")
					and getgenv().Lazyness == true then

					child.HoldDuration = child.HoldDuration * 2
				end
			end)
		end

		local clone = door:Clone()
		clone.Name = "DoorClone"
		clone.Parent = door.Parent

		local cloneDoor
		local cloneKnob
		local hinge

		repeat
			if not door.Parent or not clone.Parent then
				return
			end

			cloneDoor = nil
			cloneKnob = nil
			hinge = nil

			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("BasePart") then
					if v.Name == "Door" then
						cloneDoor = v
					elseif v.Name == "Knob" then
						cloneKnob = v
					elseif v.Name == "Hinge" then
						hinge = v
					end
				end
			end

			if not cloneDoor then
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("Model") and v.Name == "Door" then
						cloneDoor = v:FindFirstChildWhichIsA("BasePart", true)

						if cloneDoor then
							break
						end
					end
				end
			end

			if not cloneKnob or not cloneDoor then
				task.wait()
			end
		until cloneDoor and cloneKnob

		if not door.Parent or not clone.Parent then
			return
		end

		door:SetAttribute("LockedDoorScanned", true)

		for _, v in ipairs(door:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name ~= "Lock" and not v:FindFirstAncestor("Lock") then
					v.Transparency = 1
				end

			elseif v:IsA("SurfaceGui") and v.Name == "Sign" then
				v:Destroy()

			elseif v:IsA("Sound") then
				if v.Name ~= "Fall" and v.Name ~= "Unlock" then
					v.Volume = 0
				end
			end
		end

		for _, v in ipairs(clone:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name == "Lock" or v.Name == "Hidden" then
					v.Transparency = 1
				end

				if v.Name == "Lock" then
					for _, d in ipairs(v:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Transparency = 1
						elseif d:IsA("ProximityPrompt") then
							d:Destroy()
						end
					end
				end
			end
		end

		local openSound

		for _, v in ipairs(cloneDoor:GetDescendants()) do
			if v:IsA("Sound") and v.Name == "Open" then
				openSound = v
				break
			end
		end

		local bellSound

		for _, v in ipairs(cloneDoor:GetDescendants()) do
			if v:IsA("Sound") and v.Name == "Bell" then
				bellSound = v
				break
			end
		end

		task.spawn(function()
			local customPrompt
			local triggered = false

			while door.Parent and clone.Parent do
				if realPrompt
					and realPrompt.Parent
					and realPrompt.Enabled == false
					and not customPrompt
					and not triggered
					and cloneKnob
					and cloneKnob.Parent then

					customPrompt = Instance.new("ProximityPrompt")
					customPrompt.Style = Enum.ProximityPromptStyle.Custom
					customPrompt.ActionText = "Open Door"
					customPrompt.ObjectText = "Door"
					customPrompt.MaxActivationDistance = 7
					customPrompt.RequiresLineOfSight = false

					-- FIX: prompt phải nằm trên Knob của CLONE
					customPrompt.Parent = cloneKnob

					customPrompt.Triggered:Connect(function()
					if triggered then
					return
				end

				triggered = true
				
						if not customPrompt or not customPrompt.Parent then
							return
						end

						customPrompt:Destroy()

						for _, v in ipairs(clone:GetDescendants()) do
							if v:IsA("BasePart") and v.Name == "Collision" then
								v.CanCollide = false
							end
						end

						local char =
							LocalPlayer.Character
							or LocalPlayer.CharacterAdded:Wait()

						local hum = char:WaitForChild("Humanoid")
						local hrp = char:WaitForChild("HumanoidRootPart")

						local cf, size = clone:GetBoundingBox()

						local targetPos =
							cf.Position
							- cf.LookVector * (size.Z / 2 + 2)

						local targetCF =
							CFrame.lookAt(targetPos, cf.Position)

						local oldCF = cloneDoor.CFrame

						local function GetOpenCF()
							local angle = 95

							local relative =
								cloneDoor.CFrame:PointToObjectSpace(
									hrp.Position
								)

							if relative.Z > 0 then
								angle = -95
							end

							if hinge and hinge:IsA("BasePart") then
								local offset =
									hinge.CFrame:ToObjectSpace(oldCF)

								return
									hinge.CFrame
									* CFrame.Angles(
										0,
										math.rad(angle),
										0
									)
									* offset
							else
								return
									oldCF
									* CFrame.Angles(
										0,
										math.rad(angle),
										0
									)
							end
						end

						hum.AutoRotate = false
						hrp.Anchored = true

						local wee = TweenService:Create(
							hrp,
							TweenInfo.new(
								0.7,
								Enum.EasingStyle.Exponential,
								Enum.EasingDirection.Out
							),
							{CFrame = targetCF}
						)

						wee:Play()

						task.spawn(function()
							local Anim = Instance.new("Animation")
							Anim.AnimationId = "rbxassetid://18759987341"

							local Track = hum:LoadAnimation(Anim)

							Track:AdjustSpeed(0.3)
							Track:Play()

							task.wait(0.3)

							if Track then
								Track:AdjustSpeed(0)
							end

							task.wait(0.3)

							if Track then
								Track:AdjustSpeed(0.5)
							end

							task.wait(0.59)
							task.wait(0.01)

							if wee then
								wee:Cancel()
							end

							if hrp.Parent then
								hrp.CFrame =
									hrp.CFrame
									+ hrp.CFrame.LookVector * 8
							end

							Track:Stop()
							Anim:Destroy()
						end)

						task.delay(0.3, function()
							if not clone.Parent then
								return
							end

							if openSound then
								openSound:Play()
							end

							if bellSound then
								bellSound:Play()
							end

							TweenService:Create(
								cloneDoor,
								TweenInfo.new(
									1,
									Enum.EasingStyle.Exponential,
									Enum.EasingDirection.Out
								),
								{CFrame = GetOpenCF()}
							):Play()
						end)

						task.delay(0.4, function()
							if hrp.Parent then
								hrp.Anchored = false
								hum.AutoRotate = true
							end
						end)
					end)

				elseif customPrompt
					and not customPrompt.Parent then

					customPrompt = nil
				end

				task.wait(0.01)
			end
		end)
	end)
end

local function SetupDoor(door)
	if not (
		door:IsA("Model")
		and (door.Name == "Door" or door.Name == "DoorFake")
	) then
		return
	end

	if door:GetAttribute("DoorScanned") then
		return
	end

	task.spawn(function()
		local knob
		local hasKeyHitbox = false
		local hasMovableObjects = false

		repeat
			if not door.Parent then
				return
			end

			knob = nil
			hasKeyHitbox = false
			hasMovableObjects = false

			for _, v in ipairs(door:GetDescendants()) do
				if v.Name == "KeyHitbox" then
					hasKeyHitbox = true
				end

				if v:IsA("BasePart") and v.Name == "Knob" then
					knob = v
				end

				if v.Name:sub(1, 5) == "Func_"
					or v.Name == "ClientOpen"
					or v.Name == "Hidden"
					or v.Name == "Collision" then

					hasMovableObjects = true
				end
			end

			-- KeyHitbox có thể load sau Door
			if not hasKeyHitbox and door.Parent then
				for _, v in ipairs(door.Parent:GetDescendants()) do
					if v.Name == "KeyHitbox" then
						hasKeyHitbox = true
						break
					end
				end
			end

			if not knob or not hasMovableObjects then
				task.wait()
			end
		until knob and hasMovableObjects

		if not door.Parent then
			return
		end

		-- Nếu KeyHitbox cuối cùng mới xuất hiện thì chuyển sang LockedDoor
		if hasKeyHitbox then
			SetupLockedDoor(door)
			return
		end

		if DoorData[door] then
			return
		end

		door:SetAttribute("DoorScanned", true)

		DoorData[door] = {
			Moved = {},
			Prompt = nil,
			AutoMode = false,
			PermanentAuto = false
		}

		local moved = DoorData[door].Moved

		for _, obj in ipairs(door:GetDescendants()) do
			if obj.Name:sub(1, 5) == "Func_"
				or obj.Name == "ClientOpen"
				or obj.Name == "Hidden"
				or obj.Name == "Collision" then

				table.insert(moved, {
					Object = obj,
					Parent = obj.Parent
				})

				obj.Parent = nil
			end
		end

		if #moved == 0 then
			DoorData[door] = nil
			door:SetAttribute("DoorScanned", nil)
			return
		end

		local prompt = Instance.new("ProximityPrompt")
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.ActionText = "Open Door"
		prompt.ObjectText = "Door"
		prompt.MaxActivationDistance =
			SpeedAutoPrompt and 11 or 7
		prompt.RequiresLineOfSight = false
		prompt.Parent = knob

		DoorData[door].Prompt = prompt

		local autoOpen = false

		prompt.PromptShown:Connect(function()
			if SpeedAutoPrompt then
				fireproximityprompt(prompt)
				return
			end

			if autoOpen then
				return
			end

			if not workspace:FindFirstChild("RipperBla") then
				return
			end

			local room = tonumber(door.Parent.Name)

			if not room or room ~= LatestRoom.Value then
				return
			end

			autoOpen = true

			DoorData[door].AutoMode = true
			DoorData[door].PermanentAuto = true

			door:SetAttribute("RipperOpened", true)

			for _, info in ipairs(moved) do
				if info.Object and info.Parent then
					info.Object.Parent = info.Parent
				end
			end

			fireproximityprompt(prompt)
		end)

		prompt.Triggered:Connect(function()
			local room = tonumber(door.Parent.Name)

			if room and room == LatestRoom.Value then
				DoorData[door].AutoMode = true
				DoorData[door].PermanentAuto = true
			end

			prompt:Destroy()

			if workspace:FindFirstChild("RipperBla") then
				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end

				return
			end

			local char =
				LocalPlayer.Character
				or LocalPlayer.CharacterAdded:Wait()

			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			if SpeedAutoPrompt then
				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end

				return
			end

			local cf, size = door:GetBoundingBox()

			local targetPos =
				cf.Position
				- cf.LookVector * (size.Z / 2 + 2)

			local targetCF =
				CFrame.lookAt(targetPos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local wee = TweenService:Create(
				hrp,
				TweenInfo.new(
					0.7,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = targetCF}
			)

			wee:Play()

			task.spawn(function()
				local Anim = Instance.new("Animation")
				Anim.AnimationId = "rbxassetid://18759987341"

				local Track = hum:LoadAnimation(Anim)
				Track:AdjustSpeed(0.3)
				Track:Play()

				task.wait(0.3)

				Track:AdjustSpeed(0)

				task.wait(0.3)

				Track:AdjustSpeed(0.5)

				task.wait(0.59)
				task.wait(0.01)

				wee:Cancel()

				hrp.CFrame =
					hrp.CFrame
					+ hrp.CFrame.LookVector * 8

				Track:Stop()
				Anim:Destroy()
			end)

			task.delay(0.3, function()
				if not door.Parent then
					return
				end

				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end
			end)

			task.delay(0.4, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end
			end)
		end)
	end)
end

local function SetupWardrobe(wardrobe)
	if not (
		wardrobe:IsA("Model")
		and wardrobe.Name == "Wardrobe"
	) then
		return
	end

	if wardrobe:GetAttribute("WardrobeScanned") then
		return
	end

	task.spawn(function()
		local prompt
		local main
		local hiddenValue

		repeat
			if not wardrobe.Parent then
				return
			end

			prompt = wardrobe:FindFirstChildWhichIsA(
				"ProximityPrompt",
				true
			)

			main = wardrobe:FindFirstChild("Main", true)
			hiddenValue = wardrobe:FindFirstChild(
				"HiddenPlayer",
				true
			)

			if not prompt or not main or not hiddenValue then
				task.wait()
			end
		until prompt and main and hiddenValue

		if not wardrobe.Parent then
			return
		end

		if wardrobe:GetAttribute("Singular") then
			return
		end

		wardrobe:SetAttribute("WardrobeScanned", true)

		prompt.ActionText = "Njkx"
		prompt.Enabled = false
		prompt.HoldDuration = 0.25

		local openPrompt = prompt:Clone()
		openPrompt.Parent = prompt.Parent
		openPrompt.Enabled = true
		openPrompt.HoldDuration = 0.25
		openPrompt.ActionText = "Hide"

		local closePrompt = openPrompt:Clone()
		closePrompt.Parent = prompt.Parent
		closePrompt.Enabled = false
		closePrompt.ActionText = "Close"

		local originalEnterSound
		local enterSound
		local exitSound

		-- Sound có thể được stream/load sau nên đợi riêng từng sound
		local soundEnter

		repeat
			if not wardrobe.Parent then
				return
			end

			soundEnter = wardrobe:FindFirstChild(
				"SoundEnter",
				true
			)

			if not soundEnter then
				task.wait()
			end
		until soundEnter

		local soundExit

		repeat
			if not wardrobe.Parent then
				return
			end

			soundExit = wardrobe:FindFirstChild(
				"SoundExit",
				true
			)

			if not soundExit then
				task.wait()
			end
		until soundExit

		for _, v in ipairs(wardrobe:GetDescendants()) do
			if v:IsA("Sound") then
				if v.Name == "SoundEnter" then
					originalEnterSound = v

					enterSound = Instance.new("Sound")
					enterSound.Name = "SoundEnterClone"
					enterSound.RollOffMaxDistance = 30
					enterSound.Volume = 0.7

					enterSound.SoundId =
						GetGitSound(
							"https://github.com/cakmay227-svg/random/raw/refs/heads/main/openCloset%20new.mp3.oga.mp3?raw=true",
							"jcjiejbhcus",
							workspace
						).SoundId

					enterSound.Parent = v.Parent

				elseif v.Name == "SoundExit" then
					exitSound = v:Clone()
					exitSound.Name = "SoundExitClone"
					exitSound.RollOffMaxDistance = 30
					exitSound.Volume = 0.7

					exitSound.SoundId =
						GetGitSound(
							"https://github.com/cakmay227-svg/random/raw/refs/heads/main/closeCloset%20new.mp3.oga.mp3?raw=true",
							"kckjjebbcrd",
							workspace
						).SoundId

					exitSound.Parent = v.Parent
				end
			end
		end

		local track

		local checkingMain = false
		local checkingHidden = false

		local function IsNearMain()
			if not main then
				return false
			end

			local char = LocalPlayer.Character

			if not char then
				return false
			end

			local hrp = char:FindFirstChild(
				"HumanoidRootPart"
			)

			if not hrp then
				return false
			end

			local mainPos

			if main:IsA("BasePart") then
				mainPos = main.Position

			elseif main:IsA("Model") then
				mainPos = main:GetPivot().Position

			else
				return false
			end

			return (hrp.Position - mainPos).Magnitude < 4
		end

		local function StartMainCheck()
			if checkingMain then
				return
			end

			checkingMain = true

			task.spawn(function()
				while checkingMain do
					if closePrompt.Enabled then
						if IsNearMain() then
							closePrompt.Enabled = false
							prompt.Enabled = true
						else
							prompt.Enabled = false
							closePrompt.Enabled = true
						end
					end

					task.wait(0.1)
				end

				checkingMain = false
			end)
		end

		local function StopMainCheck()
			checkingMain = false
			prompt.Enabled = false
		end

		local function StopHiddenCheck()
			checkingHidden = false
		end

		local function StartHiddenCheck()
			if checkingHidden or not hiddenValue then
				return
			end

			checkingHidden = true

			task.spawn(function()
				while checkingHidden do
					local value = hiddenValue.Value

					if value == LocalPlayer.Name then
						openPrompt.Enabled = false
						closePrompt.Enabled = false
					else
						checkingHidden = false

						openPrompt.Enabled = true
						closePrompt.Enabled = false
						prompt.Enabled = false

						break
					end

					task.wait(0.3)
				end

				checkingHidden = false
			end)
		end

		local function PlayWardrobeAnimation()
			local controller =
				wardrobe:FindFirstChildOfClass(
					"AnimationController"
				)

			if not controller then
				controller = Instance.new(
					"AnimationController"
				)

				controller.Parent = wardrobe
			end

			local animator =
				controller:FindFirstChildOfClass("Animator")

			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = controller
			end

			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://9451146136"

			if track then
				track:Stop(0)
				track:Destroy()
				track = nil
			end

			track = animator:LoadAnimation(anim)
			track:Play()
			track:AdjustSpeed(0.8)

			task.spawn(function()
				repeat
					task.wait()
				until track.Length > 0

				task.wait(track.Length / 2)

				if track and track.IsPlaying then
					track:AdjustSpeed(0)
				end
			end)
		end

		openPrompt.Triggered:Connect(function()
			openPrompt.Enabled = false

			local char =
				LocalPlayer.Character
				or LocalPlayer.CharacterAdded:Wait()

			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local cf, size = wardrobe:GetBoundingBox()

			local targetPos =
				cf.Position
				+ cf.LookVector * (size.Z / 2 + 2)

			local targetCF =
				CFrame.lookAt(targetPos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local tween = TweenService:Create(
				hrp,
				TweenInfo.new(
					0.5,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.Out
				),
				{CFrame = targetCF}
			)

			tween:Play()

			task.delay(0.25, function()
				if enterSound then
					enterSound:Play()
				end

				local player = Players.LocalPlayer

				local charLocal =
					player.Character
					or player.CharacterAdded:Wait()

				local humLocal =
					charLocal:WaitForChild("Humanoid")

				local animator =
					humLocal:FindFirstChildOfClass("Animator")
					or Instance.new(
						"Animator",
						humLocal
					)

				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://98224925603818"

				local trackAnim =
					animator:LoadAnimation(anim)

				trackAnim.Priority =
					Enum.AnimationPriority.Action4

				trackAnim:Play()
				trackAnim:AdjustSpeed(0.6)

				task.spawn(function()
					trackAnim.Stopped:Wait()

					if trackAnim then
						trackAnim:Stop()
						trackAnim:Destroy()
					end

					anim:Destroy()
				end)

				closePrompt.Enabled = true
				StartMainCheck()
			end)

			task.delay(0.25, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end

				PlayWardrobeAnimation()
			end)
		end)

		closePrompt.Triggered:Connect(function()
			StopMainCheck()
			StopHiddenCheck()

			closePrompt.Enabled = false

			local char =
				LocalPlayer.Character
				or LocalPlayer.CharacterAdded:Wait()

			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local cf, size = wardrobe:GetBoundingBox()

			local targetPos =
				cf.Position
				+ cf.LookVector * (size.Z / 2 + 2)

			local targetCF =
				CFrame.lookAt(targetPos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local tween = TweenService:Create(
				hrp,
				TweenInfo.new(
					0.7,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = targetCF}
			)

			tween:Play()

			task.delay(0.3, function()
				if exitSound then
					exitSound:Play()
				end

				local player = Players.LocalPlayer

				local charLocal =
					player.Character
					or player.CharacterAdded:Wait()

				local humLocal =
					charLocal:WaitForChild("Humanoid")

				local animator =
					humLocal:FindFirstChildOfClass("Animator")
					or Instance.new(
						"Animator",
						humLocal
					)

				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://9461439496"

				local trackAnim =
					animator:LoadAnimation(anim)

				trackAnim.Priority =
					Enum.AnimationPriority.Action4

				trackAnim:Play()

				repeat
					task.wait()
				until trackAnim.Length > 0

				trackAnim.TimePosition = 0.2
				trackAnim:AdjustSpeed(-0.6)

				task.wait(0.5)

				if trackAnim then
					trackAnim:Stop()
					trackAnim:Destroy()
				end

				anim:Destroy()
			end)

			task.delay(0.4, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end

				if track then
					track:AdjustSpeed(0.7)

					task.spawn(function()
						local remaining =
							track.Length - track.TimePosition

						task.wait(remaining / 0.7)

						openPrompt.Enabled = true
					end)
				else
					openPrompt.Enabled = true
				end
			end)
		end)

		prompt.Triggered:Connect(function()
			if originalEnterSound then
				originalEnterSound.Volume = 0
			end

			if exitSound then
				exitSound:Play()
			end

			prompt.Enabled = false

			StopMainCheck()
			StartHiddenCheck()

			if track then
				track:Stop(0)
				track:Destroy()
				track = nil
			end
		end)
	end)
end

local function Process(inst)
if inst:IsA("Model") then
if inst.Name == "DoorNormal" then
SetupDoorNormal(inst)
elseif inst.Name == "Door" or inst.Name == "DoorFake" then
SetupDoor(inst)
elseif inst.Name == "Wardrobe" then
	task.defer(function()
		if not inst.Parent then
			return
		end

		SetupWardrobe(inst)
	end)
elseif inst.Name == "KeyHitbox" then  
	hasKeyHitbox = true  
end

end
end

hasKeyHitbox = currentRooms:FindFirstChild("KeyHitbox", true) ~= nil

for _, v in ipairs(currentRooms:GetDescendants()) do
Process(v)
end

task.delay(1, function()
for _, v in ipairs(currentRooms:GetDescendants()) do
Process(v)
end
end)

currentRooms.DescendantAdded:Connect(Process)

local function RestoreDoors()
for door, data in pairs(DoorData) do
if door.Parent and not data.PermanentAuto then
for _, info in ipairs(data.Moved) do
if info.Object and info.Parent then
info.Object.Parent = info.Parent
end
end

if data.Prompt then  
			data.Prompt.Enabled = false  
		end  
	end  
end

end

local ripperAlive = false

local function UpdateDoors()
local alive = workspace:FindFirstChild("RipperBla") ~= nil

if alive == ripperAlive then  
	return  
end  

ripperAlive = alive  

if alive then  
	RestoreDoors()  
else  
	for door, data in pairs(DoorData) do  
		if door.Parent then  
			if door:GetAttribute("RipperOpened")   
			or data.PermanentAuto   
			or data.AutoMode then  
				continue  
			end  
		end  
	end  
end

end

workspace.ChildAdded:Connect(function(obj)
if obj:IsA("Model") and obj.Name == "RipperBla" then
UpdateDoors()

obj.AncestryChanged:Connect(function(_, parent)  
		if not parent then  
			UpdateDoors()  
		end  
	end)  
end

end)

local function SetupSpeedCheck(char)
	local hum = char:WaitForChild("Humanoid")

	local function Update()
	SpeedAutoPrompt = hum.WalkSpeed > 16

	for _, data in pairs(DoorData) do
		if data.Prompt then
			data.Prompt.MaxActivationDistance = SpeedAutoPrompt and 11 or 7
		end
	end
end

	Update()

	hum:GetPropertyChangedSignal("WalkSpeed"):Connect(Update)
end

if LocalPlayer.Character then
	task.spawn(SetupSpeedCheck, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(SetupSpeedCheck)

UpdateDoors() 

print("work")

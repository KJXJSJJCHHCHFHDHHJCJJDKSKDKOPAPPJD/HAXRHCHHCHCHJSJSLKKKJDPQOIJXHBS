}

local function hasAncestorContaining(obj, name)
	local p = obj.Parent

	while p do
		if p:IsA("Model") and p ~= obj then
			if string.find(p.Name:lower(), name, 1, true) then
				return true
			end
		end

		if p == CurrentRooms then
			break
		end

		p = p.Parent
	end

	return false
end

local function isBlacklisted(obj)
	local name = obj.Name:lower()

	if obj:IsA("BasePart") then
		if string.find(name, "book", 1, true) then
			return not hasAncestorContaining(obj, "book")
		end

		if string.find(name, "light", 1, true) then
			return not hasAncestorContaining(obj, "book")
		end

		if string.find(name, "wall", 1, true) then
			return not hasAncestorContaining(obj, "pillar")
		end

		if string.find(name, "board", 1, true) then
			return not hasAncestorContaining(obj, "wooden")
		end
	end

	for _, name in ipairs(blacklist) do
		if string.find(obj.Name:lower(), name, 1, true) then
			return true
		end
	end

	return false
end

local function hasTargetParent(target, room)
	local p = target.Parent

	while p and p ~= room do
		if p:IsA("Model") then
			return true
		end
		p = p.Parent
	end

	return false
end

local function shakeCollision(part)
	if not part or not part.Parent then return end

	for _, v in ipairs(part:GetConnectedParts(true)) do
		if v:IsA("BasePart") and not v.Anchored then
			v.AssemblyLinearVelocity += Vector3.new(
				math.random(-20, 20),
				math.random(10, 30),
				math.random(-20, 20)
			)
		end
	end
end

local TARGET_MASS = 0

local function isInside(part, model)
	return part == model or part:IsDescendantOf(model)
end

local function FlingTarget(target)
	if not target or not target:IsA("Model") or not target.Parent then
		return
	end

	if target:GetAttribute("Flinging") or isBlacklisted(target) then
		return
	end

	local room = target.Parent
	while room and room.Parent ~= CurrentRooms do
		room = room.Parent
	end

	if not room or room.Parent ~= CurrentRooms then
		return
	end

	if hasTargetParent(target, room) then
		return
	end

	target:SetAttribute("Flinging", true)

	local targets = {}
	local collision

	for _, v in ipairs(target:GetDescendants()) do
		if v:IsA("BasePart")
			and v.Name == "Collision"
			and v:GetAttribute("WindCollision") == true then
			collision = v
			break
		end
	end

	if not collision then
		local parts = {}

		for _, v in ipairs(target:GetDescendants()) do
			if v:IsA("BasePart")
				and v.Name ~= "Collision"
				and not isBlacklisted(v) then
				table.insert(parts, v)
			end
		end

		if #parts > 0 then
			local cf, size = target:GetBoundingBox()
			local volume = size.X * size.Y * size.Z

			if volume > 0 then
				collision = Instance.new("Part")
				collision.Name = "Collision"
				collision.Size = size
				collision.CFrame = cf
				collision.Transparency = 1
				collision.CanCollide = true
				collision.CanTouch = true
				collision.CanQuery = true
				collision.CastShadow = false
				collision.Anchored = true
				collision.Massless = false
				collision.CustomPhysicalProperties = PhysicalProperties.new(
					math.clamp(TARGET_MASS / volume, 0.0001, 100),
					0.3,
					0.5,
					1,
					1
				)

				collision:SetAttribute("WindCollision", true)
				collision:SetAttribute("Picked", false)
				collision.Parent = target

				collision:GetPropertyChangedSignal("Anchored"):Connect(function()
					if not collision.Anchored then
						task.spawn(shakeCollision, collision)
					end
				end)

				for _, v in ipairs(target:GetDescendants()) do
					if v:IsA("WeldConstraint")
						or v:IsA("Weld")
						or v:IsA("ManualWeld")
						or v:IsA("Motor6D")
						or v:IsA("Snap")
						or v:IsA("Glue")
						or v:IsA("RigidConstraint") then
						local p0 = v.Part0
						local p1 = v.Part1

						if p0 and p1 and isInside(p0, target) ~= isInside(p1, target) then
							v:Destroy()
						end
					end
				end

				for _, part in ipairs(parts) do
					part.Anchored = false
					part.CanCollide = false
					part.CanTouch = false
					part.CanQuery = false
					part.Massless = true

					local weld = Instance.new("WeldConstraint")
					weld.Part0 = collision
					weld.Part1 = part
					weld.Parent = collision
				end
			end
		end
	end

	if not collision then
		target:SetAttribute("Flinging", nil)
		return
	end

	collision.Anchored = false

	task.delay(1, function()
		if target.Parent then
			target:SetAttribute("Flinging", nil)
		end
	end)
end

local function InsideRoom(room, pos)
	if not room or not room:IsA("Model") then
		return false
	end

	local cf, size = room:GetBoundingBox()
	local p = cf:PointToObjectSpace(pos)

	return math.abs(p.X) <= size.X / 2
		and math.abs(p.Y) <= size.Y / 2
		and math.abs(p.Z) <= size.Z / 2
end

